    public static class MetamagicRod_Patch
    {
        
        [Harmony12.HarmonyPatch(typeof(MetamagicRodMechanics), "IsSuitableAbility")]
        public static class MetamagicRodMechanics_IsSuitableAbility_Patch
        {
            // This is a Prefix patch. It runs *before* the original IsSuitableAbility method.
            // If it returns 'false', the original method is skipped completely.
            public static bool Prefix(MetamagicRodMechanics __instance, ref bool __result, BlueprintAbility ability)
            {
               
                var forbidComponent = ability.GetComponent<ForbidSpecificMetamagic>();

                
                if (forbidComponent == null)
                {
                    return true; 
                }

                
                if (forbidComponent.MetamagicToForbid == __instance.Metamagic)
                {
                    
                    __result = false;

                    
                    return false; 
                }

               
                return true;
            }
        }
    }
        
