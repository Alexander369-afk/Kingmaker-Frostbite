        public class RegularACFrostbiteEnchantmentController : WeaponEnchantmentLogic,
IInitiatorRulebookHandler<RulePrepareDamage>,
IInitiatorRulebookHandler<RuleAttackWithWeapon>
        {
            public BlueprintBuff m_CasterBuff;

            [NonSerialized]
            private bool? _spellSucceededThisAttack;

            private static readonly HashSet<WeaponCategory> ValidWeaponCategories = new HashSet<WeaponCategory>
{
    WeaponCategory.UnarmedStrike, WeaponCategory.Claw, WeaponCategory.Bite,
    WeaponCategory.Gore, WeaponCategory.OtherNaturalWeapons
};


            public void OnEventAboutToTrigger(RuleAttackWithWeapon evt)
            {
                if (evt.Weapon == null || !evt.Weapon.Enchantments.Contains(this.Enchantment)) return;

                // This ensures each attack in a full-round action starts fresh.
                _spellSucceededThisAttack = null;
            }

            // runs only on a confirmed hit.
            public void OnEventAboutToTrigger(RulePrepareDamage evt)
            {
                if (evt.DamageBundle.Weapon == null || !evt.DamageBundle.Weapon.Enchantments.Contains(this.Enchantment)) return;
                if (!ValidWeaponCategories.Contains(evt.DamageBundle.Weapon.Blueprint.Category)) return;

                
                var target = evt.Target;
                var oozeType = library.TryGet<BlueprintFeature>("7f8f43050f16f6f4d8d212a450b7e273");
                var swarmType = library.TryGet<BlueprintFeature>("621b62f4955b57f49a6673d3288c3a93");

                if (target.Descriptor.HasFact(Common.construct)
                    || (oozeType != null && target.Descriptor.HasFact(oozeType))
                    || (swarmType != null && target.Descriptor.HasFact(swarmType))
                    || target.Descriptor.HasFact(Common.undead))
                {
                    
                    // The charge will still be consumed in OnEventDidTrigger because it was a hit.
                    return;
                }

                var context = evt.Initiator.Descriptor.Buffs.GetBuff(m_CasterBuff)?.Context;
                if (context == null) return;

                var sr_rule = new RuleSpellResistanceCheck(context, evt.Target);
                Rulebook.Trigger(sr_rule);
                _spellSucceededThisAttack = !sr_rule.IsSpellResisted;

                if (_spellSucceededThisAttack != true) return;

                
                var damageDescription = new DamageDescription
                {
                    TypeDescription = new DamageTypeDescription
                    {
                        Type = DamageType.Energy,
                        Energy = DamageEnergyType.Cold
                    },
                    Dice = new DiceFormula(1, DiceType.D6),
                    Bonus = Math.Max(1, Math.Min(10, context.Params.CasterLevel)) 
                };

                
                var frostbiteDamage = damageDescription.CreateDamage();

                
                if (context.HasMetamagic(Metamagic.Empower))
                {
                    frostbiteDamage.EmpowerBonus = 1.5f;
                }
                if (context.HasMetamagic(Metamagic.Maximize))
                {
                    frostbiteDamage.Maximized = true;
                }

                
                evt.DamageBundle.Add(frostbiteDamage);
            }


            public void OnEventDidTrigger(RuleAttackWithWeapon evt)
            {
                if (evt.Weapon == null || !evt.Weapon.Enchantments.Contains(this.Enchantment)) return;


                if (evt.AttackRoll.IsHit && ValidWeaponCategories.Contains(evt.Weapon.Blueprint.Category))
                {
                    var context = evt.Initiator.Descriptor.Buffs.GetBuff(m_CasterBuff)?.Context;
                    if (context != null)
                    {
                        var reduce_duration_action = Helpers.Create<ContextActionReduceBuffDuration>(c => {
                            c.TargetBuff = m_CasterBuff;
                            c.DurationValue = Helpers.CreateContextDuration(1, DurationRate.Hours);
                        });
                        using (context.GetDataScope(evt.Initiator))
                        {
                            reduce_duration_action.RunAction();
                        }
                    }
                }


                if (evt.AttackRoll.IsHit && _spellSucceededThisAttack == true)
                {
                    var context = evt.Initiator.Descriptor.Buffs.GetBuff(m_CasterBuff)?.Context;
                    if (context != null)
                    {
                        var fatigued = library.Get<BlueprintBuff>("e6f2fc5d73d88064583cb828801212f4");
                        var apply_fatigue_action = Common.createContextActionApplyBuff(fatigued, Helpers.CreateContextDuration(1, DurationRate.Minutes), is_child: true);
                        using (context.GetDataScope(evt.Target))
                        {
                            apply_fatigue_action.RunAction();
                        }
                    }
                }
            }

            public void OnEventDidTrigger(RulePrepareDamage evt) { }
        }



        public class ApplyRegularACFrostbiteEnchantToWeapons : BuffLogic, IUnitSubscriber
        {
            public BlueprintWeaponEnchantment Enchantment;

            public WeaponCategory[] Categories = new WeaponCategory[] {
    WeaponCategory.UnarmedStrike, WeaponCategory.Claw, WeaponCategory.Bite,
    WeaponCategory.Gore, WeaponCategory.OtherNaturalWeapons
};

            public override void OnFactActivate() { ApplyEnchantment(); }
            public override void OnFactDeactivate() { RemoveEnchantment(); }

            private void ApplyEnchantment()
            {
                foreach (var weapon in this.Owner.Body.AdditionalLimbs.Concat(this.Owner.Body.Hands).Select(h => h.Weapon))
                {
                    if (weapon != null && this.Categories.Contains(weapon.Blueprint.Category))
                    {
                        weapon.AddEnchantment(this.Enchantment, this.Context);
                    }
                }
            }

            private void RemoveEnchantment()
            {
                foreach (var weapon in this.Owner.Body.AdditionalLimbs.Concat(this.Owner.Body.Hands).Select(h => h.Weapon))
                {
                    if (weapon != null)
                    {
                        // FIX: Correctly find the INSTANCE of the enchantment to remove it.
                        var enchantmentInstance = weapon.Enchantments.FirstOrDefault(e => e.Blueprint == this.Enchantment);
                        if (enchantmentInstance != null)
                        {
                            weapon.RemoveEnchantment(enchantmentInstance);
                        }
                    }
                }
            }
        }

        public class RemoveSelfOnSpellCast : BuffLogic, IInitiatorRulebookHandler<RuleCastSpell>
        {
            // This method is called by the Rulebook right BEFORE a spell resolves.
            public void OnEventAboutToTrigger(RuleCastSpell evt)
            {
                
                this.Buff.Remove();
            }

            
            public void OnEventDidTrigger(RuleCastSpell evt) { }
        }

